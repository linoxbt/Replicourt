# Reown AppKit project ID (free, from https://cloud.reown.com). Wallet-connect is
# disabled with a clear in-app notice until this is set. This is the only variable
# the running app actually reads — network + contract addresses are configured in
# src/lib/networks.ts, not env vars.
VITE_REOWN_PROJECT_ID=

# Written automatically by `deploy/deployScript.ts` when deploying to localnet/
# studionet — not read by the app itself, kept here only for the deploy script.
VITE_CONTRACT_ADDRESS=
VITE_GL_CHAIN=studionet
